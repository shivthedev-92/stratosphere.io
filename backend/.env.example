# Copy to .env and fill in real values. Never commit .env.

# Postgres — matches docker-compose defaults
DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/productivity

# JWT — generate a strong random string: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-use-a-real-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
ACCESS_COOKIE_SECURE=false
API_DOCS_ENABLED=true

# AI provider: "ollama" (default, free) or "anthropic" (needs API key)
AI_PROVIDER=ollama

# Ollama (used when AI_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Anthropic (used when AI_PROVIDER=anthropic)
# Get API key at console.anthropic.com — separate from Anthropic Pro (claude.ai)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Public frontend URL used in password-reset links
FRONTEND_URL=http://localhost:3000

# Optional SMTP delivery. AWS SES SMTP credentials work here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
