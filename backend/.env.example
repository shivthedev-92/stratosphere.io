# Copy to .env and fill in real values. Never commit .env.

# Postgres — matches docker-compose defaults
DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/productivity

# JWT — generate a strong random string: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-use-a-real-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
ACCESS_COOKIE_SECURE=false
API_DOCS_ENABLED=true

# AI provider: "ollama" (default, free) or "anthropic" (needs API key)
AI_PROVIDER=ollama

# Ollama (used when AI_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Anthropic (used when AI_PROVIDER=anthropic)
# Get API key at console.anthropic.com — separate from Anthropic Pro (claude.ai)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Coach spend controls: max coach replies per user in any 24 hours (0 = no
# limit), and max characters of chat history sent with each message.
COACH_DAILY_MESSAGE_LIMIT=50
COACH_HISTORY_MAX_CHARS=6000

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Public frontend URL used in password-reset links
FRONTEND_URL=http://localhost:3000

# Optional SMTP delivery. AWS SES SMTP credentials work here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Telegram reminders (optional). Create a bot with @BotFather (/newbot), then
# set both values; the username is without the leading @. Leave empty to
# disable. Keep the token secret: anyone holding it controls the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Sign-in with Google and Microsoft (personal accounts). Register these
# redirect URIs with each provider for local development:
#   http://localhost:8000/auth/oauth/google/callback
#   http://localhost:8000/auth/oauth/microsoft/callback
# A provider shows up only when both its id and secret are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional: only these email domains may sign in, e.g. gmail.com,outlook.com
OAUTH_ALLOWED_EMAIL_DOMAINS=
# New accounts come from Google/Microsoft only; existing password accounts
# can still sign in. Set true to reopen email + password sign-up.
PASSWORD_SIGNUP_ENABLED=false
# Local API origin the providers redirect back to.
OAUTH_REDIRECT_BASE=http://localhost:8000
