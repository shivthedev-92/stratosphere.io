{$SITE_ADDRESS} {
    encode zstd gzip

    handle_path /api/* {
        reverse_proxy api:8000
    }

    handle {
        reverse_proxy web:3000
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # script-src keeps 'unsafe-inline' because Next.js injects inline
        # hydration scripts. Tightening it further requires nonce-based CSP
        # via middleware — worth doing later, not required for the demo.
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
}

# www.<domain> redirects to the bare domain (one canonical URL for cookies,
# CORS and links). Caddy gets a certificate for it once its DNS record exists.
# SITE_REDIRECTS (optional, space-separated) lists older addresses that
# should redirect too, such as the sslip.io name used before the domain;
# without it, browsers visiting an old address get a failed TLS handshake.
www.{$SITE_ADDRESS} {$SITE_REDIRECTS} {
    redir https://{$SITE_ADDRESS}{uri} permanent
}
