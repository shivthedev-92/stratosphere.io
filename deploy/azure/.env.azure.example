# Copy to .env.azure and never commit the resulting file.
# For an initial deployment, replace 203.0.113.10 with the VM public IP.
# sslip.io resolves the embedded IP and lets Caddy obtain a trusted TLS certificate.
SITE_ADDRESS=203-0-113-10.sslip.io
PUBLIC_URL=https://203-0-113-10.sslip.io
# Optional, space-separated: older addresses that should redirect to
# SITE_ADDRESS (e.g. the sslip.io name after moving to a real domain).
SITE_REDIRECTS=

POSTGRES_DB=stratosphere
POSTGRES_USER=stratosphere
# Letters and digits only: it is placed inside the database URL, where "/", "@"
# or "+" break the connection. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-value
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRE_MINUTES=1440

# AI coach: Claude Haiku 4.5 via the Anthropic API. Needs an API key from
# console.anthropic.com (separate from a claude.ai subscription). With the key
# empty the coach answers "not configured"; set AI_PROVIDER=disabled to hide it.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Coach spend controls: max coach replies per user in any 24 hours (0 = no
# limit), and max characters of chat history sent with each message.
COACH_DAILY_MESSAGE_LIMIT=50
COACH_HISTORY_MAX_CHARS=6000

# Optional SMTP configuration for password-reset email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Telegram reminders (optional). Create a bot with @BotFather (/newbot), then
# set both values; the username is without the leading @. Leave empty to
# disable. Keep the token secret: anyone holding it controls the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Sign-in with Google and Microsoft (personal accounts). Register these
# redirect URIs with each provider (replace the host with SITE_ADDRESS):
#   https://example.com/api/auth/oauth/google/callback
#   https://example.com/api/auth/oauth/microsoft/callback
# A provider shows up only when both its id and secret are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional: only these email domains may sign in, e.g. gmail.com,outlook.com
OAUTH_ALLOWED_EMAIL_DOMAINS=
# New accounts come from Google/Microsoft only; existing password accounts
# can still sign in. Set true to reopen email + password sign-up.
PASSWORD_SIGNUP_ENABLED=false
