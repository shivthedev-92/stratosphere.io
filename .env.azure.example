# Copy to .env.azure and never commit the resulting file.
# For an initial deployment, replace 203.0.113.10 with the VM public IP.
# sslip.io resolves the embedded IP and lets Caddy obtain a trusted TLS certificate.
SITE_ADDRESS=203-0-113-10.sslip.io
PUBLIC_URL=https://203-0-113-10.sslip.io

POSTGRES_DB=stratosphere
POSTGRES_USER=stratosphere
POSTGRES_PASSWORD=replace-with-a-long-random-value
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRE_MINUTES=1440

# Keep disabled unless a hosted provider key is configured.
AI_PROVIDER=disabled
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional SMTP configuration for password-reset email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Telegram reminders (optional). Create a bot with @BotFather (/newbot), then
# set both values; the username is without the leading @. Leave empty to
# disable. Keep the token secret: anyone holding it controls the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
