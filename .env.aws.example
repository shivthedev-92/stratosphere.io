# Copy to .env.aws and never commit the resulting file.
# A domain you control is preferred. For a temporary demo, <PUBLIC_IP>.sslip.io works.
SITE_ADDRESS=stratosphere.example.com
PUBLIC_URL=https://stratosphere.example.com

POSTGRES_DB=stratosphere
POSTGRES_USER=stratosphere
POSTGRES_PASSWORD=replace-with-a-long-random-value
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRE_MINUTES=1440

# Keep disabled unless a hosted provider key is configured.
AI_PROVIDER=disabled
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: configure AWS SES SMTP credentials for password reset delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
