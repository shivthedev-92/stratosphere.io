# Local development: use the computer's LAN address when testing on a physical device.
# Azure: use the public HTTPS API path, for example https://your-domain.example/api.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8000
# Optional: the web app's address, used for the Privacy link in Settings.
# EXPO_PUBLIC_WEB_URL=https://your-domain.example
